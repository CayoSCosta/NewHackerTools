@{
    // Força o Identity a ignorar o layout padrão do Bootstrap e usar o nosso layout hacker principal
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6">
    <div class="border-b border-gray-200 dark:border-terminal-border pb-4">
        <div class="text-xs text-terminal-green mb-1">// OPERATOR_PROFILE_SETTINGS</div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-wide">Configurações de Conta do Operador</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="md:col-span-1 bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 shadow-2xl h-fit transition-colors duration-200">
            <div class="text-[10px] uppercase tracking-wider text-gray-700 dark:text-gray-400 mb-3 font-mono">// NAVEGAÇÃO</div>
            <partial name="_ManageNav" />
        </div>

        <div class="md:col-span-3 bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 shadow-2xl text-gray-700 dark:text-gray-300 transition-colors duration-200">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}