@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil do Operador";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="space-y-4">
    <h3 class="text-sm font-bold text-gray-900 dark:text-white tracking-wider">// DADOS DE IDENTIFICAÇÃO</h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-950/40 border border-red-900 p-2.5 rounded" role="alert"></div>

        <div>
            <label asp-for="Username" class="block text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Identificação (Login)</label>
            <input asp-for="Username" class="w-full bg-gray-100 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-700 dark:text-gray-400 cursor-not-allowed font-mono transition-colors duration-200" disabled />
        </div>

        <div>
            <label asp-for="Input.PhoneNumber" class="block text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Canal de Contato / Telefone</label>
            <input asp-for="Input.PhoneNumber" class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-900 dark:text-gray-300 focus:outline-none focus:border-terminal-green font-mono transition-colors duration-200" placeholder="Informe seu contato seguro..." />
            <span asp-validation-for="Input.PhoneNumber" class="text-xs text-red-400 mt-1 block"></span>
        </div>

        <button id="update-profile-button" type="submit" class="bg-terminal-green text-black font-bold px-4 py-2 rounded hover:bg-emerald-400 transition-all uppercase tracking-wider text-xs shadow-[0_0_15px_rgba(0,255,102,0.2)]">
            > Salvar Alterações
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}