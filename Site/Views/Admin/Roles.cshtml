@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Gestão de Grupos e Níveis";
}

<div class="space-y-6">
    <div class="border-b border-gray-200 dark:border-terminal-border pb-4 flex justify-between items-end">
        <div>
            <div class="text-xs text-terminal-green mb-1">// ACCESS_CONTROL_GROUPS</div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-wide">Gestão de Grupos de Permissão</h1>
        </div>
        <a asp-action="Index" class="text-xs bg-white dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border px-3 py-1.5 rounded text-gray-700 dark:text-gray-300 hover:text-terminal-green transition-all duration-200">
            &larr; Voltar para Operadores
        </a>
    </div>

    <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 shadow-2xl max-w-lg transition-colors duration-200">
        <h2 class="text-sm font-bold text-gray-900 dark:text-white mb-4 uppercase tracking-wider">// CRIAR NOVO GRUPO TÁTICO</h2>
        <form asp-action="CreateRole" method="post" class="flex space-x-3">
            <input type="text" name="roleName" placeholder="Ex: RedTeam, BlueTeam, Auditing..." class="flex-1 bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-900 dark:text-gray-300 focus:outline-none focus:border-terminal-green transition-colors duration-200" required />
            <button type="submit" class="bg-terminal-green text-black font-bold px-4 py-2 rounded text-xs hover:bg-emerald-400 transition-all uppercase tracking-wider">
                > Criar Grupo
            </button>
        </form>
    </div>

    <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg overflow-hidden shadow-2xl transition-colors duration-200">
        <div class="p-4 bg-gray-50 dark:bg-terminal-dark border-b border-gray-200 dark:border-terminal-border text-xs text-gray-700 dark:text-gray-300 font-mono">
            <span>GRUPOS ATIVOS NO SISTEMA</span>
        </div>
        <table class="w-full text-left border-collapse text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-terminal-border text-gray-600 dark:text-gray-400 text-xs uppercase bg-gray-50 dark:bg-black/40">
                    <th class="p-4">Identificação do Grupo (Role)</th>
                    <th class="p-4">ID de Referência</th>
                    <th class="p-4 text-right">Controle</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-terminal-border">
                @if (Model != null && Model.Any())
                {
                    @foreach (var role in Model)
                    {
                        <tr class="hover:bg-gray-100 dark:hover:bg-terminal-muted/50 transition-colors duration-200">
                            <td class="p-4 text-terminal-green font-mono flex items-center space-x-2">
                                <i class="fa-solid fa-users-rectangle text-xs"></i>
                                <span>@role.Name</span>
                            </td>
                            <td class="p-4 text-gray-700 dark:text-gray-400 text-xs font-mono">@role.Id</td>
                            <td class="p-4 text-right">
                                @if (role.Name != "Admin")
                                {
                                    <form asp-action="DeleteRole" asp-route-roleId="@role.Id" method="post" class="inline" onsubmit="return confirm('Excluir este grupo removerá a permissão de todos os usuários associados. Prosseguir?');">
                                        <button type="submit" class="bg-white dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border text-xs px-2.5 py-1.5 rounded hover:border-red-500 text-gray-700 dark:text-gray-300 hover:text-red-400 transition-all duration-200">
                                            <i class="fa-solid fa-trash-can"></i> Excluir Grupo
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-700 dark:text-gray-400 font-mono italic">Protegido pelo Sistema</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>