@{
    ViewData["Title"] = "JSON & JWT Inspector";
}

<div class="space-y-6 font-mono">
    
    <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 shadow-2xl flex items-center justify-between transition-colors duration-200">
        <div>
            <div class="flex items-center space-x-2 text-xs text-terminal-green mb-1">
                <i class="fa-solid fa-code"></i>
                <span>DEV_TOOLS // PAYLOAD_INSPECTOR</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-white tracking-wider">JSON FORMATTER & JWT DECODER</h1>
        </div>
        <div class="hidden md:flex items-center space-x-2 text-xs bg-gray-50 dark:bg-terminal-dark px-3 py-1.5 rounded border border-gray-200 dark:border-terminal-border text-terminal-green transition-colors duration-200">
            <span class="w-2 h-2 rounded-full bg-terminal-green animate-pulse"></span>
            <span>PARSER ONLINE</span>
        </div>
    </div>

    <div class="flex space-x-2 border-b border-gray-200 dark:border-terminal-border pb-2">
        <button onclick="switchTab('json')" id="tabJsonBtn" class="px-4 py-2 text-xs font-bold rounded bg-terminal-green text-black transition-all duration-200">
            <i class="fa-solid fa-brackets-curly mr-2"></i> Validador & Formatador JSON
        </button>
        <button onclick="switchTab('jwt')" id="tabJwtBtn" class="px-4 py-2 text-xs font-bold rounded bg-white dark:bg-terminal-panel text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-terminal-border hover:text-gray-900 dark:hover:text-white transition-all duration-200">
            <i class="fa-solid fa-key mr-2"></i> Decodificador JWT
        </button>
    </div>

    <div id="jsonSection" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-3 transition-colors duration-200">
            <div class="flex justify-between items-center text-xs text-gray-700 dark:text-gray-300">
                <span>// INPUT_JSON (RAW)</span>
                <button onclick="clearJsonInput()" class="text-red-400 hover:text-red-300">Limpar</button>
            </div>
            <textarea id="jsonInput" rows="12" class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-terminal-green focus:outline-none focus:border-terminal-green resize-none font-mono transition-colors duration-200"></textarea>
            <button onclick="formatJson()" class="w-full bg-terminal-green text-black py-2.5 rounded font-bold text-xs hover:bg-emerald-400 transition-all flex items-center justify-center space-x-2">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span>VALIDAR E FORMATAR JSON</span>
            </button>
        </div>

        <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-3 transition-colors duration-200">
            <div class="flex justify-between items-center text-xs text-gray-700 dark:text-gray-300">
                <span id="jsonStatusLabel">// OUTPUT_FORMATTED</span>
                <button onclick="copyJsonOutput()" class="text-terminal-green hover:underline">Copiar</button>
            </div>
            <pre id="jsonOutput" class="w-full h-64 bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-gray-700 dark:text-gray-300 overflow-auto font-mono select-all transition-colors duration-200"></pre>
        </div>
    </div>

    <div id="jwtSection" class="hidden space-y-6">
        <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-3 transition-colors duration-200">
            <div class="text-xs text-gray-700 dark:text-gray-300">// ENTRADA_JWT_TOKEN</div>
            <input type="text" id="jwtInput" class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-terminal-green focus:outline-none focus:border-terminal-green font-mono transition-colors duration-200" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...">
            <button onclick="decodeJwt()" class="w-full bg-terminal-green text-black py-2.5 rounded font-bold text-xs hover:bg-emerald-400 transition-all flex items-center justify-center space-x-2">
                <i class="fa-solid fa-unlock-keyhole"></i>
                <span>DECODIFICAR TOKEN JWT</span>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-2 transition-colors duration-200">
                <span class="text-[10px] text-red-400 font-bold uppercase tracking-wider">// 1. HEADER (ALGORITMO & TIPO)</span>
                <pre id="jwtHeaderOutput" class="bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-red-400 dark:text-red-300 h-48 overflow-auto font-mono transition-colors duration-200"></pre>
            </div>
            @* <span class="text-[10px] text-terminal-green font-bold uppercase tracking-wider">// 2. PAYLOAD (DADOS & CLAIMS)</span> *@
            <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-2 md:col-span-1 transition-colors duration-200">
                <span class="text-[10px] text-terminal-green font-bold uppercase tracking-wider">// 2. PAYLOAD (DADOS & CLAIMS)</span>
                <pre id="jwtPayloadOutput" class="bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-terminal-green h-48 overflow-auto font-mono transition-colors duration-200"></pre>
            </div>
            <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-4 flex flex-col space-y-2 transition-colors duration-200">
                <span class="text-[10px] text-yellow-500 font-bold uppercase tracking-wider">// 3. SIGNATURE (ASSINATURA)</span>
                <div id="jwtSigOutput" class="bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-yellow-600 dark:text-yellow-300 h-48 overflow-auto font-mono break-all transition-colors duration-200"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            const jsonBtn = document.getElementById('tabJsonBtn');
            const jwtBtn = document.getElementById('tabJwtBtn');
            const jsonSec = document.getElementById('jsonSection');
            const jwtSec = document.getElementById('jwtSection');

            if (tab === 'json') {
                jsonBtn.className = "px-4 py-2 text-xs font-bold rounded bg-terminal-green text-black transition-all duration-200";
                jwtBtn.className = "px-4 py-2 text-xs font-bold rounded bg-white dark:bg-terminal-panel text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-terminal-border hover:text-gray-900 dark:hover:text-white transition-all duration-200";
                jsonSec.classList.remove('hidden');
                jwtSec.classList.add('hidden');
            } else {
                jwtBtn.className = "px-4 py-2 text-xs font-bold rounded bg-terminal-green text-black transition-all duration-200";
                jsonBtn.className = "px-4 py-2 text-xs font-bold rounded bg-white dark:bg-terminal-panel text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-terminal-border hover:text-gray-900 dark:hover:text-white transition-all duration-200";
                jwtSec.classList.remove('hidden');
                jsonSec.classList.add('hidden');
            }
        }

        async function formatJson() {
            const input = document.getElementById('jsonInput').value;
            const output = document.getElementById('jsonOutput');
            const status = document.getElementById('jsonStatusLabel');

            try {
                const response = await fetch('/DevTools/FormatJson', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ input: input })
                });
                const data = await response.json();

                if (data.success) {
                    output.textContent = data.result;
                    output.className = "w-full h-64 bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-terminal-green overflow-auto font-mono select-all transition-colors duration-200";
                    status.textContent = "// STATUS: JSON VÁLIDO & FORMATADO";
                    status.className = "text-xs text-terminal-green";
                } else {
                    output.textContent = data.message;
                    output.className = "w-full h-64 bg-gray-50 dark:bg-terminal-dark border border-red-500 rounded p-3 text-xs text-red-500 dark:text-red-400 overflow-auto font-mono select-all transition-colors duration-200";
                    status.textContent = "// STATUS: ERRO DE SINTAXE DETECTADO";
                    status.className = "text-xs text-red-400";
                }
            } catch (err) {
                output.textContent = "Erro de comunicação com o servidor.";
            }
        }

        async function decodeJwt() {
            const token = document.getElementById('jwtInput').value;
            const headerOut = document.getElementById('jwtHeaderOutput');
            const payloadOut = document.getElementById('jwtPayloadOutput');
            const sigOut = document.getElementById('jwtSigOutput');

            try {
                const response = await fetch('/DevTools/DecodeJwt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token })
                });
                const data = await response.json();

                if (data.success) {
                    headerOut.textContent = data.header;
                    payloadOut.textContent = data.payload;
                    sigOut.textContent = data.signature;
                } else {
                    headerOut.textContent = data.message;
                    payloadOut.textContent = "";
                    sigOut.textContent = "";
                }
            } catch (err) {
                headerOut.textContent = "Erro ao processar o token JWT.";
            }
        }

        function clearJsonInput() {
            document.getElementById('jsonInput').value = '';
            document.getElementById('jsonOutput').textContent = '';
        }

        function copyJsonOutput() {
            const text = document.getElementById('jsonOutput').textContent;
            navigator.clipboard.writeText(text);
            alert("JSON copiado para a área de transferência!");
        }
    </script>
}