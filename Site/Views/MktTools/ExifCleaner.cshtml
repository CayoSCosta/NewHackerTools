@{
    ViewData["Title"] = "Metadata Scrubber / Exif Cleaner";
}

<div class="space-y-6 font-mono">
    
    <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 shadow-2xl flex items-center justify-between transition-colors duration-200">
        <div>
            <div class="flex items-center space-x-2 text-xs text-yellow-500 mb-1">
                <i class="fa-solid fa-shield-halved"></i>
                <span>MKT_TOOLS // METADATA_SCRUBBER</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-white tracking-wider">EXIF & METADATA CLEANER</h1>
        </div>
        <div class="hidden md:flex items-center space-x-2 text-xs bg-gray-50 dark:bg-terminal-dark px-3 py-1.5 rounded border border-gray-200 dark:border-terminal-border text-yellow-500 transition-colors duration-200">
            <span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>
            <span>PRIVACY SHIELD ACTIVE</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-gray-50 dark:bg-terminal-dark border border-red-500 rounded p-4 text-xs text-red-500 dark:text-red-400 transition-colors duration-200">
            [ERRO] > @TempData["Error"]
        </div>
    }

    <form asp-action="ScrubMetadata" method="post" enctype="multipart/form-data" class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 space-y-6 transition-colors duration-200">
        
        <div class="bg-gray-50 dark:bg-terminal-dark/50 border border-gray-200 dark:border-terminal-border rounded p-4 text-xs text-gray-700 dark:text-gray-300 space-y-2 transition-colors duration-200">
            <span class="text-yellow-500 font-bold">// O QUE ESTA FERRAMENTA REMOVE:</span>
            <ul class="list-disc pl-5 space-y-1 text-[11px]">
                <li><strong class="text-gray-700 dark:text-gray-300">Imagens (JPG, PNG):</strong> Coordenadas GPS, modelo de dispositivos, data de captura e tags EXIF.</li>
                <li><strong class="text-gray-700 dark:text-gray-300">Documentos (PDF):</strong> Autor, software criador, histórico de revisão e metadados ocultos.</li>
                <li><strong class="text-gray-700 dark:text-gray-300">Pacote Office (DOCX, XLSX):</strong> Nome de usuário da rede corporativa, organização e comentários invisíveis.</li>
            </ul>
        </div>

        <div class="space-y-2">
            <label class="block text-xs text-gray-700 dark:text-gray-300 uppercase tracking-wider">// SELECIONE O ARQUIVO PARA HIGIENIZAÇÃO</label>
            <input type="file" name="scrubFile" required class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-gray-700 dark:text-gray-300 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-bold file:bg-yellow-500 file:text-black hover:file:bg-yellow-400 transition-all duration-200 cursor-pointer font-mono">
        </div>

        <button type="submit" class="w-full bg-yellow-500 text-black py-3 rounded font-bold text-xs hover:bg-yellow-400 transition-all flex items-center justify-center space-x-2">
            <i class="fa-solid fa-eraser"></i>
            <span>EXPURGAR METADADOS E BAIXAR ARQUIVO LIMPO</span>
        </button>
    </form>

</div>