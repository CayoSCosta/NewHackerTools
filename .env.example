# Copie para .env (ignorado pelo Git) e preencha. Nunca versione valores reais.

# Porta no host (somente 127.0.0.1)
HBX_HOST_PORT=8080

# Production (padrão) ou Development
ASPNETCORE_ENVIRONMENT=Production

# Seed do Admin: e-mail aqui; no overlay PostgreSQL a senha vem de secrets/admin_seed_password.txt
# (ADMIN_SEED_PASSWORD só vale para o compose.yaml em SQLite). Exige schema já existente.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Proxy HTTPS externo autorizado (IP ou CIDR, separados por vírgula). Vazio = não confiar em forwarded headers.
# Com a rede fixa do compose.yaml, um proxy no host chega como 172.28.0.1.
HBX_TRUSTED_PROXIES=

# Limites de recursos
HBX_MEM_LIMIT=2g
HBX_CPUS=2

# PostgreSQL (somente com compose.postgres.yaml). Nomes não sensíveis; a SENHA fica em secrets/hbx_pg_password.txt
# (e a do admin em secrets/admin_seed_password.txt) — veja secrets/README.md. Não coloque senhas neste arquivo.
HBX_PG_DB=hackerbox
HBX_PG_USER=hbx
# HBX_SECRETS_DIR=./secrets
