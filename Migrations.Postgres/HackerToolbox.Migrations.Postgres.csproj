<Project Sdk="Microsoft.NET.Sdk">

  <!-- Migrations exclusivas do provider PostgreSQL. As migrations SQLite continuam em Site/Migrations. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HackerToolbox.Migrations.Postgres</AssemblyName>
    <RootNamespace>HackerToolbox.Migrations.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Site\HackerToolbox.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
