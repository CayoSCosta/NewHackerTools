@page
@model LoginModel

@{
    ViewData["Title"] = "Autenticação de Operador";
    Layout = "/Views/Shared/_Layout.cshtml"; // Força herdar o nosso layout principal hacker
}

<div class="flex justify-center items-center min-h-[75vh]">
    <div class="w-full max-w-md bg-terminal-panel border border-terminal-border rounded-lg p-8 shadow-2xl relative">
        
        <div class="absolute top-0 left-0 right-0 h-2 bg-terminal-muted rounded-t-lg flex items-center px-3 space-x-1.5 border-b border-terminal-border">
            <span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>
            <span class="w-2 h-2 rounded-full bg-yellow-500 inline-block"></span>
            <span class="w-2 h-2 rounded-full bg-terminal-green inline-block"></span>
        </div>

        <div class="mt-4 mb-6 text-center">
            <div class="text-xs text-terminal-green mb-1">// ACCESS_GATEWAY</div>
            <h1 class="text-xl font-bold text-white tracking-widest">AUTENTICAÇÃO NECESSÁRIA</h1>
        </div>

        <form id="account" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-950/40 border border-red-900 p-2.5 rounded mb-4" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Identificação (E-mail)</label>
                <input asp-for="Input.Email" class="w-full bg-terminal-dark border border-terminal-border rounded px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-terminal-green transition-colors" autocomplete="username" aria-required="true" placeholder="operador@hackerbox.net" />
                <span asp-validation-for="Input.Email" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Chave de Acesso (Senha)</label>
                <input asp-for="Input.Password" class="w-full bg-terminal-dark border border-terminal-border rounded px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-terminal-green transition-colors" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-xs text-red-400 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-between text-xs">
                <label asp-for="Input.RememberMe" class="flex items-center space-x-2 text-gray-400 cursor-pointer">
                    <input class="w-4 h-4 bg-terminal-dark border-terminal-border rounded text-terminal-green focus:ring-0" asp-for="Input.RememberMe" />
                    <span>Lembrar Sessão</span>
                </label>
            </div>

            <button id="login-submit" type="submit" class="w-full bg-terminal-green text-black font-bold py-2.5 rounded hover:bg-emerald-400 transition-all uppercase tracking-wider text-sm shadow-[0_0_15px_rgba(0,255,102,0.2)]">
                > Executar Login
            </button>

            <div class="text-center pt-4 border-t border-terminal-border mt-4 text-xs">
                <p class="text-gray-500">Não possui credenciais?</p>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-terminal-green hover:underline mt-1 inline-block">Criar nova conta de operador &rarr;</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}