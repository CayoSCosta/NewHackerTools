@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Chave de Acesso";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="space-y-4">
    <h3 class="text-sm font-bold text-white tracking-wider">// SEGURANÇA: CHAVE DE ACESSO (SENHA)</h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-950/40 border border-red-900 p-2.5 rounded" role="alert"></div>

        <div>
            <label asp-for="Input.OldPassword" class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Senha Atual</label>
            <input asp-for="Input.OldPassword" class="w-full bg-terminal-dark border border-terminal-border rounded px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-terminal-green font-mono" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.OldPassword" class="text-xs text-red-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Input.NewPassword" class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Nova Senha</label>
            <input asp-for="Input.NewPassword" class="w-full bg-terminal-dark border border-terminal-border rounded px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-terminal-green font-mono" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.NewPassword" class="text-xs text-red-400 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-xs uppercase tracking-wider text-gray-400 mb-1">Confirmar Nova Senha</label>
            <input asp-for="Input.ConfirmPassword" class="w-full bg-terminal-dark border border-terminal-border rounded px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-terminal-green font-mono" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-400 mt-1 block"></span>
        </div>

        <button type="submit" class="bg-terminal-green text-black font-bold px-4 py-2 rounded hover:bg-emerald-400 transition-all uppercase tracking-wider text-xs shadow-[0_0_15px_rgba(0,255,102,0.2)]">
            > Atualizar Senha
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}