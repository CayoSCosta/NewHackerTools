@page
@model EmailModel
@{
    ViewData["Title"] = "Gestão de E-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="space-y-4">
    <h3 class="text-sm font-bold text-gray-900 dark:text-white tracking-wider">// ENDEREÇO DE E-MAIL</h3>
    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form" method="post" class="space-y-4">
        <div asp-validation-summary="All" class="text-red-500 text-xs bg-red-950/40 border border-red-900 p-2.5 rounded" role="alert"></div>

        @if (Model.IsEmailConfirmed)
        {
            <div class="flex items-center space-x-2">
                <label asp-for="Email" class="block text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300">E-mail Principal</label>
                <span class="text-terminal-green text-xs font-mono bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800">✓ Confirmado</span>
            </div>
            <div class="relative flex items-center">
                <input asp-for="Email" class="w-full bg-gray-100 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-700 dark:text-gray-300 font-mono transition-colors duration-200" disabled />
            </div>
        }
        else
        {
            <div>
                <label asp-for="Email" class="block text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">E-mail Principal</label>
                <input asp-for="Email" class="w-full bg-gray-100 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-700 dark:text-gray-300 font-mono transition-colors duration-200" disabled />
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="mt-2 text-xs text-terminal-green hover:underline font-mono">> Enviar e-mail de confirmação</button>
            </div>
        }

        <div>
            <label asp-for="Input.NewEmail" class="block text-xs uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-1">Novo E-mail</label>
            <input asp-for="Input.NewEmail" class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded px-3 py-2 text-sm text-gray-900 dark:text-gray-300 focus:outline-none focus:border-terminal-green font-mono transition-colors duration-200" autocomplete="email" aria-required="true" placeholder="Insira o novo endereço..." />
            <span asp-validation-for="Input.NewEmail" class="text-xs text-red-400 mt-1 block"></span>
        </div>

        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="bg-terminal-green text-black font-bold px-4 py-2 rounded hover:bg-emerald-400 transition-all uppercase tracking-wider text-xs shadow-[0_0_15px_rgba(0,255,102,0.2)]">
            > Alterar E-mail
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}