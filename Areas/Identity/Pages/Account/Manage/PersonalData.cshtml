@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-4 font-mono text-xs text-gray-300">
    <h3 class="text-sm font-bold text-white tracking-wider">// ARQUIVO DE DADOS DO OPERADOR</h3>
    
    <div class="bg-terminal-dark border border-terminal-border p-4 rounded space-y-3">
        <p>Sua conta contém dados pessoais que você nos forneceu. Esta ferramenta permite baixar ou expurgar permanentemente esses dados do banco de dados SQLite.</p>
        <p class="text-red-400 font-bold">
            <i class="fa-solid fa-triangle-exclamation mr-1"></i> ATENÇÃO: Exurgar estes dados removerá sua conta permanentemente, e ela não poderá ser recuperada.
        </p>
    </div>

    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="inline">
        <button type="submit" class="bg-terminal-dark border border-terminal-border text-terminal-green px-4 py-2 rounded hover:border-terminal-green uppercase tracking-wider font-bold">
            > Descarregar Dados Pessoais (Download)
        </button>
    </form>

    <div class="pt-4 border-t border-terminal-border">
        <a id="delete" asp-page="DeletePersonalData" class="bg-red-950 text-red-400 border border-red-800 px-4 py-2 rounded inline-block hover:bg-red-900 uppercase tracking-wider font-bold">
            > Expurgar Conta Definitivamente
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}