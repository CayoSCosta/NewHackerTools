@{
    ViewData["Title"] = "Conversor & Renomeador em Massa";
}

<div class="space-y-6 font-mono">
    
    <div class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 shadow-2xl flex items-center justify-between transition-colors duration-200">
        <div>
            <div class="flex items-center space-x-2 text-xs text-yellow-500 mb-1">
                <i class="fa-solid fa-bullhorn"></i>
                <span>MKT_TOOLS // BATCH_PROCESSOR</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-white tracking-wider">MASS IMAGE CONVERTER & RENAMER</h1>
        </div>
        <div class="hidden md:flex items-center space-x-2 text-xs bg-gray-50 dark:bg-terminal-dark px-3 py-1.5 rounded border border-gray-200 dark:border-terminal-border text-yellow-500 transition-colors duration-200">
            <span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>
            <span>BULK MODE: ZIP OUTPUT</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-gray-50 dark:bg-terminal-dark border border-red-500 rounded p-4 text-xs text-red-500 dark:text-red-400 transition-colors duration-200">
            [ERRO] > @TempData["Error"]
        </div>
    }

    <form asp-action="ConvertBatch" method="post" enctype="multipart/form-data" class="bg-white dark:bg-terminal-panel border border-gray-200 dark:border-terminal-border rounded-lg p-6 space-y-6 transition-colors duration-200">
        
        <div class="space-y-2">
            <label class="block text-xs text-gray-700 dark:text-gray-300 uppercase tracking-wider">// 1. SELECIONE O LOTE DE IMAGENS (MÚLTIPLOS ARQUIVOS)</label>
            <input type="file" name="imageFiles" multiple required class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-gray-700 dark:text-gray-300 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-bold file:bg-yellow-500 file:text-black hover:file:bg-yellow-400 transition-all duration-200 cursor-pointer font-mono">
            <p class="text-[10px] text-gray-700 dark:text-gray-400">Dica: Segure CTRL ou SHIFT para selecionar várias imagens de uma vez.</p>
        </div>

        <div class="space-y-2">
            <label class="block text-xs text-gray-700 dark:text-gray-300 uppercase tracking-wider">// 2. FORMATO DE SAÍDA DESTINO</label>
            <select name="targetFormat" required class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-yellow-500 focus:outline-none focus:border-yellow-500 font-mono transition-colors duration-200">
                <option value="">-- SELECIONE O FORMATO --</option>
                <option value="webp">WebP (.webp - Recomendado para SEO)</option>
                <option value="jpg">JPEG / JPG (.jpg)</option>
                <option value="png">PNG (.png)</option>
                <option value="bmp">BMP (.bmp)</option>
                <option value="gif">GIF (.gif)</option>
                <option value="tiff">TIFF (.tiff)</option>
                <option value="ico">ICO (.ico)</option>
            </select>
        </div>

        <div class="border border-gray-200 dark:border-terminal-border bg-gray-50 dark:bg-black/40 rounded p-4 space-y-4 transition-colors duration-200">
            <div class="flex items-center space-x-3">
                <input type="checkbox" id="enableRenameCheck" name="enableRename" value="true" onchange="toggleRenameField()" class="w-4 h-4 accent-yellow-500 bg-gray-50 dark:bg-terminal-dark border-gray-200 dark:border-terminal-border rounded cursor-pointer transition-colors duration-200">
                <label for="enableRenameCheck" class="text-xs font-bold text-gray-700 dark:text-gray-300 cursor-pointer">// ATIVAR RENOMEAÇÃO EM MASSA DO LOTE</label>
            </div>

            <div id="renameOptionsContainer" class="space-y-2 opacity-40 pointer-events-none transition-all">
                <label class="block text-xs text-gray-700 dark:text-gray-300 uppercase tracking-wider">Prefixo do Nome Base (ex: 'campanha-verao')</label>
                <input type="text" id="customPrefixInput" name="customPrefix" class="w-full bg-gray-50 dark:bg-terminal-dark border border-gray-200 dark:border-terminal-border rounded p-3 text-xs text-yellow-500 focus:outline-none focus:border-yellow-500 font-mono transition-colors duration-200" placeholder="Digite o novo prefixo numérico sequencial..." disabled>
                <p class="text-[10px] text-gray-700 dark:text-gray-400">As imagens serão renomeadas automaticamente como: <span class="text-terminal-green">prefixo_1.webp</span>, <span class="text-terminal-green">prefixo_2.webp</span>, etc.</p>
            </div>
        </div>

        <button type="submit" class="w-full bg-yellow-500 text-black py-3 rounded font-bold text-xs hover:bg-yellow-400 transition-all flex items-center justify-center space-x-2">
            <i class="fa-solid fa-file-zipper"></i>
            <span>PROCESSAR LOTE E BAIXAR ARQUIVO ZIP</span>
        </button>
    </form>

</div>

@section Scripts {
    <script>
        function toggleRenameField() {
            const checkbox = document.getElementById('enableRenameCheck');
            const container = document.getElementById('renameOptionsContainer');
            const inputField = document.getElementById('customPrefixInput');

            if (checkbox.checked) {
                container.classList.remove('opacity-40', 'pointer-events-none');
                inputField.removeAttribute('disabled');
                inputField.setAttribute('required', 'required');
            } else {
                container.classList.add('opacity-40', 'pointer-events-none');
                inputField.setAttribute('disabled', 'disabled');
                inputField.removeAttribute('required');
                inputField.value = '';
            }
        }
    </script>
}