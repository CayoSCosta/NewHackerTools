<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hacker Toolbox</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: {
        terminal: {
        dark: '#050505',
        panel: '#0a0a0a',
        border: '#171717',
        green: '#00ff66',
        muted: '#262626'
        }
        }
        }
        }
        }
    </script>
</head>

<body
    class="bg-terminal-dark text-gray-300 font-mono antialiased min-h-screen flex flex-col selection:bg-terminal-green selection:text-black">

    @using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<header
        class="fixed top-0 left-0 right-0 h-16 bg-terminal-panel border-b border-terminal-border z-50 flex items-center justify-between px-6 shadow-2xl">
        <div class="flex items-center space-x-4">
            <button id="sidebarToggle"
                    class="text-terminal-green hover:text-white transition-colors focus:outline-none">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-terminal text-terminal-green animate-pulse"></i>
                <span class="font-bold text-white tracking-widest text-lg">HACKER<span
                    class="text-terminal-green">.TOOLBOX</span></span>
                </div>
            </div>

            <div class="flex items-center space-x-6">
                <div
                    class="hidden md:flex items-center space-x-3 text-xs text-terminal-green bg-black px-3 py-1.5 rounded border border-terminal-border">
                    <span class="inline-block w-2 h-2 rounded-full bg-terminal-green animate-ping"></span>
                    <span>STATUS: SECURE_LINK</span>
                </div>

                <div class="relative">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <button id="userMenuButton"
                                class="flex items-center space-x-2 bg-terminal-dark border border-terminal-border px-3 py-1.5 rounded hover:border-terminal-green transition-colors focus:outline-none">
                            <i class="fa-solid fa-user-secret text-terminal-green"></i>
                            <span class="text-xs text-gray-300 font-mono">@User.Identity?.Name</span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-gray-500"></i>
                        </button>

                        <div id="userDropdown"
                             class="hidden absolute right-0 mt-2 w-48 bg-terminal-panel border border-terminal-border rounded shadow-2xl py-1 z-50 text-xs font-mono">
                            <div class="px-4 py-2 border-b border-terminal-border text-gray-500 text-[10px]">
                                SESSÃO ATIVA
                            </div>
                            <a asp-area="Identity" asp-page="/Account/Manage/Index"
                               class="block px-4 py-2.5 text-gray-300 hover:bg-terminal-muted hover:text-terminal-green transition-colors">
                                <i class="fa-solid fa-id-badge w-5"></i> Minha Conta
                            </a>
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit"
                                        class="w-full text-left px-4 py-2.5 text-red-400 hover:bg-terminal-muted hover:text-red-300 transition-colors flex items-center">
                                    <i class="fa-solid fa-power-off w-5"></i> Logoff
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-3 text-xs">
                            <a asp-area="Identity" asp-page="/Account/Login"
                               class="text-gray-400 hover:text-terminal-green transition-colors">Login</a>
                            <span class="text-terminal-border">|</span>
                            <a asp-area="Identity" asp-page="/Account/Register"
                               class="bg-terminal-green text-black px-3 py-1.5 rounded font-bold hover:bg-emerald-400 transition-all">Registro</a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <div class="flex pt-16 flex-1">

            <aside id="sidebar"
                   class="w-64 bg-terminal-panel border-r border-terminal-border transition-all duration-300 flex flex-col fixed inset-y-0 pt-16 z-40">
                <div class="flex-1 py-6 px-4 space-y-2 overflow-y-auto">
                    <div class="text-[10px] uppercase tracking-wider text-gray-600 px-3 mb-2 sidebar-label">Navegação</div>

                    <a href="/"
                       class="flex items-center space-x-3 px-3 py-2.5 rounded hover:bg-terminal-muted text-gray-400 hover:text-terminal-green transition-all group">
                        <i class="fa-solid fa-house text-lg w-6 text-center group-hover:text-terminal-green"></i>
                        <span class="sidebar-text whitespace-nowrap">Dashboard</span>
                    </a>

                    <div class="text-[10px] uppercase tracking-wider text-gray-600 px-3 mt-6 mb-2 sidebar-label">Ferramentas
                        de Rede</div>

                        <div>
                            <a href="/ProxyReverso"
                               class="flex items-center space-x-3 px-3 py-2.5 rounded bg-terminal-muted text-terminal-green border-l-2 border-terminal-green transition-all group">
                                <i class="fa-solid fa-network-wired text-lg w-6 text-center"></i>
                                <span class="sidebar-text whitespace-nowrap font-semibold">Proxy Reverso</span>
                            </a>
                        </div>

                        <a href="#"
                           class="flex items-center space-x-3 px-3 py-2.5 rounded hover:bg-terminal-muted text-gray-400 hover:text-terminal-green transition-all group opacity-50 cursor-not-allowed">
                            <i class="fa-solid fa-shield-halved text-lg w-6 text-center"></i>
                            <span class="sidebar-text whitespace-nowrap">Scanner de Portas</span>
                        </a>

                        <a href="#"
                           class="flex items-center space-x-3 px-3 py-2.5 rounded hover:bg-terminal-muted text-gray-400 hover:text-terminal-green transition-all group opacity-50 cursor-not-allowed">
                            <i class="fa-solid fa-bug text-lg w-6 text-center"></i>
                            <span class="sidebar-text whitespace-nowrap">Payload Injector</span>
                        </a>
                    </div>

                    <div
                        class="p-4 border-t border-terminal-border text-xs text-gray-600 sidebar-footer flex items-center justify-between">
                        <span>v1.0.0-core</span>
                        <i class="fa-solid fa-microchip text-terminal-green"></i>
                    </div>
                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <div class="text-[10px] uppercase tracking-wider text-red-500 px-3 mt-6 mb-2 sidebar-label">Zona Restrita
                        </div>

                        <div>
                            <a href="/Admin"
                               class="flex items-center space-x-3 px-3 py-2.5 rounded hover:bg-terminal-muted text-red-400 hover:text-red-300 transition-all group border border-red-950/50">
                                <i class="fa-solid fa-user-shield text-lg w-6 text-center"></i>
                                <span class="sidebar-text whitespace-nowrap font-semibold">Painel Admin</span>
                            </a>
                        </div>
                    }
                </aside>

                <main id="mainContent" class="flex-1 ml-64 p-8 transition-all duration-300">
                    <div class="max-w-5xl mx-auto">
                        @RenderBody()
                    </div>
                </main>
            </div>

            <script>
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                const sidebarToggle = document.getElementById('sidebarToggle');
                const sidebarTexts = document.querySelectorAll('.sidebar-text');
                const sidebarLabels = document.querySelectorAll('.sidebar-label');
                const sidebarFooter = document.querySelector('.sidebar-footer span');

                let isCollapsed = false;

                sidebarToggle.addEventListener('click', () => {
                isCollapsed = !isCollapsed;
                if (isCollapsed) {
                sidebar.classList.remove('w-64');
                sidebar.classList.add('w-20');
                mainContent.classList.remove('ml-64');
                mainContent.classList.add('ml-20');
                sidebarTexts.forEach(el => el.classList.add('hidden'));
                sidebarLabels.forEach(el => el.classList.add('hidden'));
                sidebarFooter.classList.add('hidden');
                } else {
                sidebar.classList.remove('w-20');
                sidebar.classList.add('w-64');
                mainContent.classList.remove('ml-20');
                mainContent.classList.add('ml-64');
                sidebarTexts.forEach(el => el.classList.remove('hidden'));
                sidebarLabels.forEach(el => el.classList.remove('hidden'));
                sidebarFooter.classList.remove('hidden');
                }
                });
            </script>

            <script>
                // Script do Menu Suspenso (Dropdown do Usuário)
                const userMenuButton = document.getElementById('userMenuButton');
                const userDropdown = document.getElementById('userDropdown');

                if (userMenuButton && userDropdown) {
                userMenuButton.addEventListener('click', (e) => {
                e.stopPropagation();
                userDropdown.classList.toggle('hidden');
                });

                window.addEventListener('click', () => {
                if (!userDropdown.classList.contains('hidden')) {
                userDropdown.classList.add('hidden');
                }
                });
                }
            </script>

            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>